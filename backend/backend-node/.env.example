# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- MongoDB Atlas ----
# mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/trendzytours?retryWrites=true&w=majority
MONGODB_URI=

# ---- Auth ----
# Must match the Laravel backend's JWT_SECRET during the migration window,
# otherwise every existing session is invalidated at cutover.
JWT_SECRET=
JWT_TTL=10080

# ---- CORS / cookies ----
FRONTEND_URL=http://localhost:3000
# Blank locally. In production: .trendzytours.com  (leading dot shares the
# cookie between trendzytours.com and api.trendzytours.com)
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# ---- Brevo (transactional email + newsletter contacts) ----
# Optional. Without a key the lead notification and newsletter sync are
# skipped silently; the contact form itself still records the lead.
BREVO_API_KEY=
BREVO_LIST_ID=
BREVO_SENDER_EMAIL=noreply@trendzytours.com
BREVO_NOTIFY_EMAIL=support@trendzytours.com

# ---- MySQL source, only for scripts/migrate-from-mysql.js ----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=trendzy_tours
MYSQL_USER=sail
MYSQL_PASSWORD=password
